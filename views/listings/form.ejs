<% layout("./layouts/boilerplate.ejs") %>

    <body>
        <h1 class="form-h1">Creating a New Listing</h1>
        <form class="row g-3" action="/listings" method="post">
            <div class="col-8 offset-2">
                <label for="title" class="form-label">Title</label>
                <input placeholder="Enter the Title" class="form-control" class="form-control" type="text" id="title" name="title">
            </div>
            <br><br><br>
            <div class="col-8  offset-2">
                <label for="description" class="form-label">description</label>
                <textarea placeholder="Enter the description"class="form-control" id="description" name="description"></textarea>
            </div>
            <br><br><br>
            <div class="col-8  offset-2">
                <label for="image" class="form-label">image-url:</label>
                <input placeholder="Enter the Url of image" class="form-control" class="form-control" type="text" id="image" name="image">
            </div>
            <div class="col-8  offset-2">
                <label for="price" class="form-label">price</label>
                <input placeholder="Enter the price "class="form-control" class="form-control" type="number" id="price" name="price">
            </div>
            <br><br><br>
            <div class="col-4 offset-2">
                <label for="Location" class="form-label">Loaction</label>
                <input placeholder="Enter the country" class="form-control" class="form-control" type="text" id="Location" name="location">
            </div>
            <div class="col-4 ">
                <label for="country" class="form-label">country</label>
                <input placeholder="Enter the Loaction" class="form-control" type="text" id="country" name="country">
            </div>
            <div class="col-12 offset-2">
                <button type="submit" class="btn btn-dark form-btn">Add</button>
                <br><br>
            </div>
        </form>
    </body>