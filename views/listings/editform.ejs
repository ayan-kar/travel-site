<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Your Listing</title>
</head>
<body>
    <h1>Creating a New Listing</h1>
    <form action="/listings/<%=result.id%>?_method=PATCH" method="post">
        <label for="title">Title</label>
        <input type="text" id="title"name="title"
        value="<%=result.title%>">
        <br><br><br>
        <label for="description">description</label>
        <textarea name="description"><%= result.description %></textarea>
            <br><br><br>
        <label for="image">image-url:</label>
        <input type="text" id="image"name="image" value="<%=result.image%>">
        <br><br><br>
        <label for="price">price</label>
        <input type="number" id="price"name="price" value="<%=result.price%>">
        <br><br><br>
        <label for="Location">Loaction</label>
        <input type="text" id="Location"name="location" value="<%=result.location%>">
        <br><br><br>
        <label for="country">country</label>
        <input type="text" id="country"name="country" value="<%=result.country%>">
        <br><br><br>
        <button>Edit</button>
    </form>
</body>
</html>