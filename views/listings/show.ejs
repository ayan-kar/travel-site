<% layout("./layouts/boilerplate.ejs") %>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <h3 class="show-h3">Listing Details : </h3>
                <div class="card ">
                    <img src="<%=result.image%>" class="card-img-top show-img" alt="noimg">
                    <div class="card-body">
                        <h5 class="card-title"><b>
                                <%=result.title %>
                            </b></h5>
                        <p class="card-text">
                            <%=result.description %>
                                <br>&#8377;<%=result.price.toLocaleString("en-IN") %> <br>
                                    <%=result.location %>,&nbsp;<%=result.country%>
                        </p>
                        <div class="d-flex">
                        <div class="col-2">
                            <a href="/listings/<%=result.id%>/edit" class="btn btn-primary show-edit-btn ">Edit this</a>
                        </div>
                        <div class="col-4 ">
                            <form action="/listings/<%=result.id%>?_method=DELETE" method="post">
                                <button class="btn btn-dark ">DELETE</button>
                        </div>
                        </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </body>
    <% layout("./layouts/boilerplate.ejs") %>