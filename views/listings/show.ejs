<% layout("./layouts/boilerplate.ejs") %>
<body>
<h3>Listing Details : </h3>
<ul>
<img src="<%=result.image%>" alt="no_img" height="200px">
<li><%=result.title %> </li>
<li><%=result.description %> </li>
<li>&#8377;<%=result.price.toLocaleString("en-IN") %></li>
<li><%=result.location %> </li>
<li><%=result.country%> </li></ul>
<br>
<a href="/listings/<%=result.id%>/edit">Edit this </a>
<form action="/listings/<%=result.id%>?_method=DELETE" method="post">
    <button>DELETE</button>
</form>
</body>
<% layout("./layouts/boilerplate.ejs") %>